# Copy this file to .env and fill in your own values. .env is never committed.

# Model A: self-hosted open-weight model (vLLM)
MODEL_A_NAME=qwen-7b
MODEL_A_BASE_URL=http://your-vllm-endpoint:8000/v1
MODEL_A_API_KEY=your-serving-stack-api-key

# Model B: OpenAI
MODEL_B_NAME=gpt-4o-mini
MODEL_B_BASE_URL=https://api.openai.com/v1
MODEL_B_API_KEY=sk-your-openai-key

# Model C: second self-hosted open-weight model (vLLM)
MODEL_C_NAME=qwen-14b
MODEL_C_BASE_URL=http://your-second-vllm-endpoint:8000/v1
MODEL_C_API_KEY=your-serving-stack-api-key

# Which models are ready to call. A model that is off is skipped by /extract
# and by benchmark runs, and shows as "not ready" in the frontend.
# Turn A and C on once their vLLM endpoints are deployed.
MODEL_A_ENABLED=false
MODEL_B_ENABLED=true
MODEL_C_ENABLED=false

# If MODEL_B_API_KEY is empty, the app falls back to the standard
# OPENAI_API_KEY, so you only need to set the key once.
# OPENAI_API_KEY=sk-your-openai-key
