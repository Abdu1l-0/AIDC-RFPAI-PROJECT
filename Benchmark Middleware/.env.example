# Copy this file to .env and fill in your own values. .env is never committed.
#
# MODEL_x_NAME must be the name the endpoint actually serves, not the
# Hugging Face repo id. For our vLLM deployments that is the value of
# --served-model-name in the manifest under k8s/; a mismatch returns 404.
#
# Both self-hosted models sit behind the same team-serving endpoint, because
# the cluster has one GPU and only one of them is resident at a time. The
# health check reports the other as "not loaded", which is expected.

# Model A: Llama 3.1 8B, self-hosted on vLLM (4-bit AWQ)
MODEL_A_NAME=NousResearch/Meta-Llama-3.1-8B-Instruct
MODEL_A_BASE_URL=https://your-serving-endpoint/v1
MODEL_A_API_KEY=your-serving-api-key

# Model B: OpenAI
MODEL_B_NAME=gpt-4o-mini
MODEL_B_BASE_URL=https://api.openai.com/v1
MODEL_B_API_KEY=sk-your-openai-key

# Model C: Qwen2.5 7B, self-hosted on vLLM (4-bit AWQ)
MODEL_C_NAME=rfp-extractor
MODEL_C_BASE_URL=https://your-serving-endpoint/v1
MODEL_C_API_KEY=your-serving-api-key

# Which models are ready to call. A model that is off is skipped by /extract
# and by benchmark runs, and shows as "off" in the frontend.
MODEL_A_ENABLED=true
MODEL_B_ENABLED=true
MODEL_C_ENABLED=true

# If MODEL_B_API_KEY is empty, the app falls back to the standard
# OPENAI_API_KEY, so you only need to set the key once.
# OPENAI_API_KEY=sk-your-openai-key
